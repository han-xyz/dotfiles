/*
 * Rofi theme — matches the AGS bar (hans/ags/style.scss).
 *
 * Palette mirrors the bar's module pills:
 *   bg              rgba(28,28,36,0.98)   like .calendar-popup-content
 *   bg-input        rgba(20,20,30,0.85)   like .module
 *   accent          #2393e9               shared cyan (workspace.active, borders)
 *   fg              white
 */

configuration {
  font: "JetBrains Mono NL Medium 11";

  timeout {
    delay: 10;
    action: "kb-cancel";
  }
}

* {
  bg:        rgba(28, 28, 36, 0.98);
  bg-input:  rgba(20, 20, 30, 0.85);
  accent:    #2393e9;
  fg:        #ffffff;
  fg-dim:    rgba(255, 255, 255, 0.6);

  background-color: transparent;
  text-color:       @fg;
  border:  0;
  margin:  0;
  padding: 0;
  spacing: 0;
}

window {
  transparency:     "real";
  background-color: @bg;
  border:           1px;
  border-color:     @accent;
  border-radius:    10px;
  width:            520px;
  padding:          10px;
}

mainbox {
  children: [inputbar, listview];
  spacing:  8px;
}

inputbar {
  children:         [prompt, entry];
  background-color: @bg-input;
  border:           1px;
  border-color:     @accent;
  border-radius:    6px;
  padding:          6px 10px;
  spacing:          8px;
}

prompt {
  text-color: @accent;
}

entry {
  text-color:        @fg;
  placeholder:       "Search…";
  placeholder-color: @fg-dim;
}

listview {
  lines:        8;
  fixed-height: false;
  spacing:      2px;
}

element {
  children:      [element-text];
  padding:       6px 10px;
  border-radius: 4px;
  spacing:       8px;
}

element selected {
  background-color: @accent;
  text-color:       @fg;
}

element-text {
  text-color:       inherit;
  background-color: transparent;
  vertical-align:   0.5;
}
